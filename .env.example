# LM Studio upstream
LM_STUDIO_URL=http://127.0.0.1:1234
# Optional: leave empty when LM Studio does not require an API key.
LM_STUDIO_API_KEY=

# Backend server binding
HOST=127.0.0.1
PORT=3000

# Comma-separated list of allowed browser origins.
# Leave empty to allow any origin (default for LAN use).
CORS_ORIGIN=

# Static assets directory served from the backend (pre-built frontend output).
# Leave empty for the default "public".
PUBLIC_DIR=public